{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vitest.config.ts"],
  // The page's script runs in a browser and is checked on its own (tsconfig.client.json).
  "exclude": ["src/client.ts", "test/client.test.ts"]
}
